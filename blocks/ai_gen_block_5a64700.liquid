{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background: {{ block.settings.background_color }};
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    box-sizing: border-box;
  }

  .ai-promo-grid-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    min-width: 0;
  }

  .ai-promo-grid-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .ai-promo-card-{{ ai_gen_id }} {
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    position: relative;
    min-height: 260px;
    transition: transform 0.4s ease;
  }

  .ai-promo-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-promo-card-big-{{ ai_gen_id }} {
    background: {{ block.settings.big_card_bg_color }};
    display: flex;
    justify-content: space-between;
    padding: 40px;
  }

  .ai-promo-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-promo-tag-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, 0.2);
    color: {{ block.settings.big_card_text_color }};
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    display: inline-block;
    backdrop-filter: blur(10px);
  }

  .ai-promo-card-big-{{ ai_gen_id }} h2 {
    font-size: {{ block.settings.big_card_heading_size }}px;
    line-height: 0.95;
    color: {{ block.settings.big_card_text_color }};
    font-weight: 900;
    margin: 10px 0;
  }

  .ai-promo-card-big-{{ ai_gen_id }} p {
    color: {{ block.settings.big_card_text_color }};
    max-width: 300px;
  }

  .ai-offer-badge-{{ ai_gen_id }} {
    width: 90px;
    height: 90px;
    border-radius: 100%;
    background: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 700;
    position: absolute;
    bottom: 30px;
    left: 40px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    font-size: 14px;
    line-height: 1.2;
  }

  .ai-promo-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 14px 28px;
    background: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 50px;
    font-weight: 600;
    transition: background 0.3s ease;
  }

  .ai-promo-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_bg_color }};
  }

  .ai-promo-btn-small-{{ ai_gen_id }} {
    background: {{ block.settings.small_button_bg_color }};
    color: {{ block.settings.small_button_text_color }};
  }

  .ai-promo-btn-small-{{ ai_gen_id }}:hover {
    background: {{ block.settings.small_button_hover_bg_color }};
  }

  .ai-promo-image-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-promo-image-{{ ai_gen_id }} img {
    width: 100%;
    max-width: 320px;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
  }

  .ai-promo-image-placeholder-{{ ai_gen_id }} {
    width: 320px;
    height: 100%;
    background: #f4f4f4;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-center-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-promo-card-dark-{{ ai_gen_id }} {
    background: {{ block.settings.dark_card_bg_color }};
    padding: 30px;
    color: {{ block.settings.dark_card_text_color }};
    min-height: 250px;
    position: relative;
  }

  .ai-promo-card-dark-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.dark_card_heading_size }}px;
    line-height: 1.1;
    margin: 10px 0;
    color: {{ block.settings.dark_card_text_color }};
  }

  .ai-floating-products-{{ ai_gen_id }} {
    position: absolute;
    right: 20px;
    top: 30px;
  }

  .ai-floating-products-{{ ai_gen_id }} img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 16px;
    border: 4px solid #fff;
    position: absolute;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .ai-floating-products-{{ ai_gen_id }} img:nth-child(1) {
    top: 0;
    right: 0;
  }

  .ai-floating-products-{{ ai_gen_id }} img:nth-child(2) {
    top: 40px;
    right: 60px;
  }

  .ai-floating-products-{{ ai_gen_id }} img:nth-child(3) {
    top: 80px;
    right: 120px;
  }

  .ai-promo-card-light-{{ ai_gen_id }} {
    background: {{ block.settings.light_card_bg_color }};
    padding: 30px;
    color: {{ block.settings.light_card_text_color }};
  }

  .ai-promo-content-center-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-promo-card-light-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.light_card_heading_size }}px;
    margin: 0 0 8px;
    color: {{ block.settings.light_card_text_color }};
  }

  .ai-gender-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 20px;
  }

  .ai-gender-box-{{ ai_gen_id }} {
    background: {{ block.settings.gender_box_bg_color }};
    border: 2px solid {{ block.settings.gender_box_border_color }};
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: {{ block.settings.gender_box_text_color }};
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease;
  }

  .ai-gender-box-{{ ai_gen_id }}:hover {
    background: {{ block.settings.gender_box_hover_bg_color }};
    transform: translateY(-3px);
  }

  .ai-gender-box-{{ ai_gen_id }} img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  .ai-gender-box-{{ ai_gen_id }} span {
    font-weight: 700;
    font-size: 14px;
  }

  .ai-promo-card-image-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-promo-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-promo-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-promo-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-overlay-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 30px;
    color: {{ block.settings.overlay_text_color }};
  }

  .ai-overlay-content-{{ ai_gen_id }} span {
    font-size: 18px;
    font-weight: 600;
    display: block;
    margin-bottom: 15px;
  }

  @media screen and (max-width: 989px) {
    .ai-promo-grid-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-promo-card-big-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-promo-image-{{ ai_gen_id }} img,
    .ai-promo-image-placeholder-{{ ai_gen_id }} {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }

    .ai-offer-badge-{{ ai_gen_id }} {
      position: static;
      margin-top: 20px;
    }

    .ai-promo-card-big-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.big_card_heading_size | times: 0.7 }}px;
    }

    .ai-promo-card-dark-{{ ai_gen_id }} h3 {
      font-size: {{ block.settings.dark_card_heading_size | times: 0.8 }}px;
    }

    .ai-floating-products-{{ ai_gen_id }} {
      position: static;
      display: flex;
      gap: 10px;
      margin-top: 20px;
    }

    .ai-floating-products-{{ ai_gen_id }} img {
      position: static;
    }
  }
{% endstyle %}

<promo-grid-{{ ai_gen_id }} class="ai-promo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-grid-container-{{ ai_gen_id }}">
    <div class="ai-promo-grid-layout-{{ ai_gen_id }}">

      <div class="ai-promo-card-{{ ai_gen_id }} ai-promo-card-big-{{ ai_gen_id }}">
        <div class="ai-promo-content-{{ ai_gen_id }}">
          {% if block.settings.big_card_tag != blank %}
            <span class="ai-promo-tag-{{ ai_gen_id }}">{{ block.settings.big_card_tag }}</span>
          {% endif %}
          
          {% if block.settings.big_card_heading != blank %}
            <h2>{{ block.settings.big_card_heading }}</h2>
          {% endif %}
          
          {% if block.settings.big_card_text != blank %}
            <p>{{ block.settings.big_card_text }}</p>
          {% endif %}

          {% if block.settings.show_badge %}
            <div class="ai-offer-badge-{{ ai_gen_id }}">
              {{ block.settings.badge_text }}
            </div>
          {% endif %}

          {% if block.settings.big_card_button_text != blank %}
            <a href="{{ block.settings.big_card_button_link }}" class="ai-promo-btn-{{ ai_gen_id }}">
              {{ block.settings.big_card_button_text }}
            </a>
          {% endif %}
        </div>

        <div class="ai-promo-image-{{ ai_gen_id }}">
          {% if block.settings.big_card_image %}
            <img
              src="{{ block.settings.big_card_image | image_url: width: 640 }}"
              alt="{{ block.settings.big_card_image.alt | escape }}"
              loading="lazy"
              width="320"
              height="400"
            >
          {% else %}
            <div class="ai-promo-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-center-column-{{ ai_gen_id }}">
        <div class="ai-promo-card-{{ ai_gen_id }} ai-promo-card-dark-{{ ai_gen_id }}">
          <div class="ai-promo-content-{{ ai_gen_id }}">
            {% if block.settings.dark_card_tag != blank %}
              <span class="ai-promo-tag-{{ ai_gen_id }}">{{ block.settings.dark_card_tag }}</span>
            {% endif %}
            
            {% if block.settings.dark_card_heading != blank %}
              <h3>{{ block.settings.dark_card_heading }}</h3>
            {% endif %}
            
            {% if block.settings.dark_card_text != blank %}
              <p>{{ block.settings.dark_card_text }}</p>
            {% endif %}

            {% if block.settings.dark_card_button_text != blank %}
              <a href="{{ block.settings.dark_card_button_link }}" class="ai-promo-btn-{{ ai_gen_id }} ai-promo-btn-small-{{ ai_gen_id }}">
                {{ block.settings.dark_card_button_text }}
              </a>
            {% endif %}
          </div>

          {% if block.settings.floating_image_1 or block.settings.floating_image_2 or block.settings.floating_image_3 %}
            <div class="ai-floating-products-{{ ai_gen_id }}">
              {% if block.settings.floating_image_1 %}
                <img
                  src="{{ block.settings.floating_image_1 | image_url: width: 160 }}"
                  alt="{{ block.settings.floating_image_1.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
              {% if block.settings.floating_image_2 %}
                <img
                  src="{{ block.settings.floating_image_2 | image_url: width: 160 }}"
                  alt="{{ block.settings.floating_image_2.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
              {% if block.settings.floating_image_3 %}
                <img
                  src="{{ block.settings.floating_image_3 | image_url: width: 160 }}"
                  alt="{{ block.settings.floating_image_3.alt | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>
          {% endif %}
        </div>

        <div class="ai-promo-card-{{ ai_gen_id }} ai-promo-card-light-{{ ai_gen_id }}">
          <div class="ai-promo-content-{{ ai_gen_id }} ai-promo-content-center-{{ ai_gen_id }}">
            {% if block.settings.light_card_heading != blank %}
              <h3>{{ block.settings.light_card_heading }}</h3>
            {% endif %}
            
            {% if block.settings.light_card_text != blank %}
              <p>{{ block.settings.light_card_text }}</p>
            {% endif %}

            <div class="ai-gender-grid-{{ ai_gen_id }}">
              <a href="{{ block.settings.men_link }}" class="ai-gender-box-{{ ai_gen_id }}">
                {% if block.settings.men_icon %}
                  <img
                    src="{{ block.settings.men_icon | image_url: width: 100 }}"
                    alt="Men"
                    loading="lazy"
                  >
                {% endif %}
                <span>{{ block.settings.men_label }}</span>
              </a>

              <a href="{{ block.settings.women_link }}" class="ai-gender-box-{{ ai_gen_id }}">
                {% if block.settings.women_icon %}
                  <img
                    src="{{ block.settings.women_icon | image_url: width: 100 }}"
                    alt="Women"
                    loading="lazy"
                  >
                {% endif %}
                <span>{{ block.settings.women_label }}</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="ai-promo-card-{{ ai_gen_id }} ai-promo-card-image-{{ ai_gen_id }}">
        {% if block.settings.right_card_image %}
          <img
            src="{{ block.settings.right_card_image | image_url: width: 800 }}"
            alt="{{ block.settings.right_card_image.alt | escape }}"
            loading="lazy"
          >
        {% else %}
          <div class="ai-promo-card-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="ai-overlay-content-{{ ai_gen_id }}">
          {% if block.settings.right_card_text != blank %}
            <span>{{ block.settings.right_card_text }}</span>
          {% endif %}
          
          {% if block.settings.right_card_button_text != blank %}
            <a href="{{ block.settings.right_card_button_link }}" class="ai-promo-btn-{{ ai_gen_id }}">
              {{ block.settings.right_card_button_text }}
            </a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</promo-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('promo-grid-{{ ai_gen_id }}', PromoGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Promo grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Big card (left)"
