ight:50px;\n  background:#ffff;\n  border-radius:10px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:22px;\n  color:#fff;\n  flex-shrink:0;\n}\n\n.info-content h3{\n  margin:0 0 10px;\n  font-size:28px;\n}\n\n.info-content p{\n  margin:0 0 8px;\n  color:#555;\n  line-height:1.6;\n}\n\n.social-icons{\n  display:flex;\n  gap:15px;\n  margin-top:15px;\n}\n\n.social-icons a{\n  text-decoration:none;\n  background:#8bc34a;\n  color:#fff;\n  padding:10px 18px;\n  border-radius:50px;\n  font-size:14px;\n  font-weight:600;\n}\n\n.contact-form-box{\n  background:#f5f5f5;\n  padding:40px;\n  border-radius:20px;\n}\n\n.contact-form-box form{\n  display:flex;\n  flex-direction:column;\n  gap:20px;\n  margin-top:30px;\n}\n\n.contact-form-box input,\n.contact-form-box textarea{\n  width:100%;\n  border:none;\n  outline:none;\n  background:#fff;\n  padding:16px 20px;\n  border-radius:12px;\n  font-size:16px;\n}\n\n.contact-form-box button{\n  border:none;\n  background:#8bc34a;\n  color:#fff;\n  padding:16px;\n  border-radius:12px;\n  font-size:16px;\n  font-weight:700;\n  cursor:pointer;\n  transition:0.3s;\n}\n\n.contact-form-box button:hover{\n  opacity:0.9;\n}\n.info-content h3,\n.info-content p{\n  color:#fff !important;\n}\n\n@media(max-width:991px){\n\n  .contact-wrapper{\n    grid-template-columns:1fr;\n  }\n\n}\n\n\n@media(max-width:767px){\n\n.contact-wrapper{\n    grid-template-columns:1fr !important;\n    gap:20px !important;\n}\n\n.contact-info{\n    width:100% !important;\n}\n\n.info-grid{\n    grid-template-columns:1fr !important;\n    gap:15px !important;\n}\n\n.info-box{\n    width:100% !important;\n    padding:18px !important;\n    border-radius:14px !important;\n    display:flex !important;\n    align-items:flex-start !important;\n    gap:15px !important;\n}\n\n.full-width{\n    grid-column:auto !important;\n}\n\n.icon-box{\n    width:42px !important;\n    height:42px !important;\n    min-width:42px !important;\n    font-size:18px !important;\n}\n\n.info-content h3{\n    font-size:20px !important;\n    margin-bottom:6px !important;\n}\n\n.info-content p{\n    font-size:14px !important;\n    line-height:1.5 !important;\n    margin-bottom:4px !important;\n}\n\n.social-icons{\n    gap:10px !important;\n    flex-wrap:wrap !important;\n}\n\n.social-icons a{\n    padding:8px 14px !important;\n    font-size:13px !important;\n}\n\n.contact-form-box{\n    width:100% !important;\n    padding:20px !important;\n    border-radius:16px !important;\n}\n\n.contact-form-box h2,\n.contact-info h2{\n    font-size:28px !important;\n    margin-bottom:20px !important;\n}\n\n.contact-form-box form{\n    gap:15px !important;\n}\n\n.contact-form-box input,\n.contact-form-box textarea{\n    padding:14px 16px !important;\n    font-size:14px !important;\n    border-radius:10px !important;\n}\n\n.contact-form-box textarea{\n    min-height:140px !important;\n}\n\n.contact-form-box button{\n    width:100% !important;\n    padding:14px !important;\n    font-size:15px !important;\n    border-radius:10px !important;\n}\n\n.contact-section{\n    padding:25px 12px !important;\n}\n\n}\n\n<\/style>","color_scheme":"scheme-2","section_width":"page-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_Kmr6WC":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<iframe src=\"https:\/\/www.google.com\/maps\/embed?pb=!1m18!1m12!1m3!1d4391.21549002699!2d72.54970967591383!3d23.108107413129705!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395e82e25cb6295d%3A0x5e78aaa40f535ca9!2sGodrej%20Garden%20City%20Rd%2C%20Ahmedabad%2C%20Gujarat%20382470!5e1!3m2!1sen!2sin!4v1778239840213!5m2!1sen!2sin\" width=\"1910\" height=\"500\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"><\/iframe>","color_scheme":"scheme-2","section_width":"full-width","padding-block-start":30,"padding-block-end":30}}},"order":["main","form","custom_liquid_NDcixf