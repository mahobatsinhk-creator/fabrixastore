an>\n      <span>Delivery & Return<\/span>\n    <\/div>\n\n    <!-- SHARE -->\n    <div class=\"option-item share-btn\" onclick=\"shareProduct()\">\n      <span class=\"icon\">🔗<\/span>\n      <span>Share<\/span>\n    <\/div>\n\n  <\/div>\n\n\n  <!-- BOXES -->\n  <div class=\"info-boxes\">\n\n    <!-- DELIVERY BOX -->\n    <div class=\"info-box\">\n\n      <div class=\"box-icon\">🚚<\/div>\n\n      <div class=\"box-content\">\n        <strong>Estimate delivery times:<\/strong>\n\n        <p>\n          12-26 days (International), 3-6 days (United States).\n        <\/p>\n      <\/div>\n\n    <\/div>\n\n\n    <!-- RETURN BOX -->\n    <div class=\"info-box\">\n\n      <div class=\"box-icon\">📦<\/div>\n\n      <div class=\"box-content\">\n        <strong>Return within 30 days<\/strong>\n\n        <p>\n          Duties & taxes are non-refundable.\n        <\/p>\n      <\/div>\n\n    <\/div>\n\n  <\/div>\n\n\n  <!-- SAFE CHECKOUT -->\n  <div class=\"safe-checkout\">\n\n    <span class=\"safe-icon\">🛡️<\/span>\n\n    <span>Guarantee Safe Checkout<\/span>\n\n  <\/div>\n\n<\/div>\n\n\n\n<style>\n\n.product-extra-info{\n  margin-top:35px;\n}\n\n\/* TOP OPTIONS *\/\n\n.top-options{\n  display:flex;\n  gap:35px;\n  align-items:center;\n  margin-bottom:30px;\n  flex-wrap:wrap;\n}\n\n.option-item{\n  display:flex;\n  align-items:center;\n  gap:10px;\n  font-size:16px;\n  font-weight:500;\n  cursor:pointer;\n  color:#333;\n}\n\n.option-item .icon{\n  width:28px;\n  height:28px;\n  border-radius:50%;\n  background:#75a93e;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:14px;\n}\n\n\/* BOXES *\/\n\n.info-boxes{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:20px;\n}\n\n.info-box{\n  background:#75a93e;\n  border-radius:14px;\n  padding:20px;\n  display:flex;\n  gap:15px;\n  align-items:flex-start;\n}\n\n.box-icon{\n  width:42px;\n  height:42px;\n  border-radius:50%;\n  background:#ffffff;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:18px;\n  flex-shrink:0;\n}\n\n.box-content strong{\n  display:block;\n  margin-bottom:6px;\n  font-size:16px;\n}\n\n.box-content p{\n  margin:0;\n  line-height:1.6;\n  color:#555;\n  font-size:15px;\n}\n\n\/* SAFE *\/\n\n.safe-checkout{\n  display:flex;\n  align-items:center;\n  gap:12px;\n  margin-top:30px;\n  font-size:17px;\n  font-weight:500;\n}\n\n.safe-icon{\n  width:34px;\n  height:34px;\n  border-radius:50%;\n  background:#75a93e;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n\/* MOBILE *\/\n\n@media(max-width:768px){\n\n.info-boxes{\n    grid-template-columns:1fr;\n}\n\n.top-options{\n    gap:20px;\n}\n\n.option-item{\n    font-size:14px;\n}\n\n.box-content strong{\n    font-size:15px;\n}\n\n.box-content p{\n    font-size:14px;\n}\n\n.safe-checkout{\n    font-size:15px;\n}\n\n}\n.product-extra-info,\n.product-extra-info p,\n.product-extra-info strong,\n.product-extra-info span,\n.product-extra-info .option-item,\n.product-extra-info .safe-checkout{\n  color:#fff !important;\n}\n.top-options .option-item,\n.top-options .option-item span{\n   color:#000 !important;\n}\n\/* SAFE CHECKOUT TEXT BLACK *\/\n\n.safe-checkout,\n.safe-checkout span{\n   color:#000 !important;\n}\n<\/style>\n\n\n\n<script>\n\nfunction shareProduct() {\n\n  if (navigator.share) {\n\n    navigator.share({\n      title: document.title,\n      text: 'Check out this product',\n      url: window.location.href\n    });\n\n  } else {\n\n    navigator.clipboard.writeText(window.location.href);\n\n    alert('Product link copied!');\n\n  }\n\n}\n\n<\/script>"},"blocks":{}},"text_aEtTtq":{"type":"text","name":"Product description","settings":{"text":"{{ closest.product.description }}","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":""